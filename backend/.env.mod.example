# Copy to backend/.env.mod when running the modular stack (docker-compose.mod.yml)
# Keep production/local-dev env files separate so you can switch stacks quickly.

# Core Django config (mod stack only)
DJANGO_ENV=development
DEBUG=1
SECRET_KEY=<set-a-local-mod-secret-key>
ADMIN_URL=admin/
DEFAULT_TENANT_DOMAIN_SUFFIX=localhost
FRONTEND_URL=https://acme.localhost:5173  # Vite dev server hitting the mod API

# Database / cache wiring – matches mod_db + mod_redis service names
DATABASE_URL=postgresql://postgres:devpass@mod_db:5432/statuswatch_mod
REDIS_URL=redis://mod_redis:6379/0
CELERY_BROKER_URL=redis://mod_redis:6379/0
CELERY_RESULT_BACKEND=redis://mod_redis:6379/1

# Stripe test credentials
# Replace these placeholders with real Stripe test values from your dashboard.
# STRIPE_PRO_PRICE_ID must be a valid recurring Stripe Price ID for the Pro plan.
STRIPE_PUBLIC_KEY=<pk_test_your_real_key>
STRIPE_SECRET_KEY=<sk_test_your_real_key>
STRIPE_PRO_PRICE_ID=<price_your_real_pro_price>
STRIPE_WEBHOOK_SECRET=<whsec_your_real_webhook_secret>
